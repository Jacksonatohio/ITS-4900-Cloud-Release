# Local .tfvars files (contain secrets)
*.tfvars
*.tfvars.json

# State files (contain sensitive data and resource IDs)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .terraform directories
.terraform/
.terraform.lock.hcl.backup

# Backup files
*.backup

# Override files (local development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Ansible inventory generated by Tofu
inventory.yml
inventory.ini
inventory_*.yml
inventory_*.ini

# NOTE: .terraform.lock.hcl is NOT ignored - commit it to ensure
# all students use the same provider versions for reproducibility
